---
import "../styles/global.css";
import { empresa } from "../data/conteudo";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const schema = {
  "@context": "https://schema.org",
  "@type": "AccountingService",
  name: empresa.nomeCompleto,
  description,
  telephone: empresa.telefones[0],
  email: empresa.email,
  foundingDate: String(empresa.fundacao),
  address: {
    "@type": "PostalAddress",
    streetAddress: empresa.endereco,
    addressLocality: empresa.cidade,
    addressRegion: empresa.uf,
    addressCountry: "BR",
  },
  areaServed: `${empresa.cidade} e região`,
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Demo de proposta: reproduz a identidade de uma empresa real, então não
        pode ser indexado nem concorrer com o site verdadeiro dela. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" href={`${base}/img/favicon-etec.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17110f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a href="#conteudo" class="pular">Pular para o conteúdo</a>
    <slot />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      document.documentElement.classList.add("js");

      const botaoMenu = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const menu = document.querySelector<HTMLElement>("#menu-principal");

      const fecharMenu = () => {
        if (!botaoMenu || !menu) return;
        botaoMenu.setAttribute("aria-expanded", "false");
        botaoMenu.setAttribute("aria-label", "Abrir menu");
        menu.classList.remove("aberto");
        document.body.style.overflow = "";
      };

      botaoMenu?.addEventListener("click", () => {
        if (!menu) return;
        const aberto = botaoMenu.getAttribute("aria-expanded") === "true";
        botaoMenu.setAttribute("aria-expanded", String(!aberto));
        botaoMenu.setAttribute("aria-label", aberto ? "Abrir menu" : "Fechar menu");
        menu.classList.toggle("aberto", !aberto);
        document.body.style.overflow = aberto ? "" : "hidden";
      });

      menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", fecharMenu));
      addEventListener("keydown", (evento) => {
        if (evento.key === "Escape") fecharMenu();
      });
      matchMedia("(min-width: 901px)").addEventListener("change", fecharMenu);

      const alvos = gsap.utils.toArray<HTMLElement>("[data-revelar]");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        alvos.forEach((el) => el.classList.add("visivel"));
      } else {
        gsap.registerPlugin(ScrollTrigger);
        alvos.forEach((el) => el.classList.add("visivel"));

        const entrada = gsap.timeline({ defaults: { ease: "power2.out" } });
        entrada
          .from(".hero .eyebrow", { y: 10, autoAlpha: 0, duration: .45 })
          .from(".hero .titulo span", { y: 18, autoAlpha: 0, duration: .6, stagger: .08 }, "-=.2")
          .from(".hero-selo, .hero .apoio, .hero-acoes", { y: 14, autoAlpha: 0, duration: .5, stagger: .07 }, "-=.3");

        const animarGrupo = (seletor: string, gatilho: string, intervalo = .07) => {
          gsap.from(seletor, {
            immediateRender: false,
            y: 20,
            autoAlpha: 0,
            duration: .58,
            stagger: intervalo,
            ease: "power2.out",
            scrollTrigger: { trigger: gatilho, start: "top 88%", once: true },
          });
        };

        animarGrupo(".fatos > div", ".fatos", .06);
        animarGrupo(".clientes .eyebrow, .marquee", ".clientes", .08);
        animarGrupo(".servico", ".servicos", .06);
        animarGrupo(".sobre-texto, .pilar", ".sobre-grade", .08);
        animarGrupo(".depoimento", ".depoimentos", .07);
        animarGrupo(".contato-grade > *", ".contato-grade", .08);

        document.querySelectorAll<HTMLElement>(".secao-cabeca").forEach((cabeca) => {
          gsap.from(cabeca.children, {
            immediateRender: false,
            y: 16,
            autoAlpha: 0,
            duration: .55,
            stagger: .07,
            ease: "power2.out",
            scrollTrigger: { trigger: cabeca, start: "top 88%", once: true },
          });
        });
      }
    </script>
  </body>
</html>

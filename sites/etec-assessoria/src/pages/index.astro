---
import Layout from "../layouts/Layout.astro";
import Icone from "../components/Icone.astro";
import {
  empresa,
  linkWhatsapp,
  hero,
  fatos,
  servicos,
  clientes,
  clientesTitulo,
  sobre,
  pilares,
  depoimentos,
  depoimentosCabeca,
  contato,
} from "../data/conteudo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${empresa.nomeCompleto} — Contabilidade em ${empresa.cidade}, ${empresa.uf}`}
  description="Escritório contábil em Castanhal desde 1987. Contabilidade, fiscal, folha de pagamento, operações rurais, declarações e legalização de empresas."
>
  <header class="topo">
    <div class="shell topo-in">
      <img src={`${base}/img/logo-etec.png`} alt={empresa.nomeCompleto} width="230" height="130" />
      <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
        <span></span><span></span><span></span>
      </button>
      <nav id="menu-principal" aria-label="Navegação principal">
        <a href="#inicio">Início</a>
        <a href="#clientes">Clientes</a>
        <a href="#servicos">Serviços</a>
        <a href="#sobre">A casa</a>
        <a href="#depoimentos">Depoimentos</a>
        <a class="nav-cta" href="#contato">Contato</a>
      </nav>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero" id="inicio">
      <div class="shell">
        <div class="hero-grade">
          <div data-revelar>
            <p class="eyebrow">{hero.eyebrow}</p>
            <h1 class="titulo">{hero.titulo.map((linha) => <span>{linha}</span>)}</h1>
          </div>
          <div data-revelar>
            <p class="hero-selo"><strong>39 anos</strong><span>de parceria com<br />empresas do Pará</span></p>
            <p class="apoio">{hero.apoio}</p>
            <div class="hero-acoes">
              <a class="btn" href={linkWhatsapp("abrir minha empresa")} target="_blank" rel="noopener noreferrer">
                {hero.cta}<i aria-hidden="true"><Icone nome="zap" size={17} /></i>
              </a>
              <a class="btn btn--vazado" href="#servicos">
                {hero.ctaSecundario}<i class="btn-mais" aria-hidden="true">+</i>
              </a>
            </div>
          </div>
        </div>

        <div class="fatos" data-revelar>
          {
            fatos.map((fato) => (
              <div>
                <strong>
                  {fato.valor}
                  {fato.sufixo && <sup>{fato.sufixo}</sup>}
                </strong>
                <span>{fato.rotulo}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>


    <section class="clientes" id="clientes" aria-labelledby="clientes-titulo">
      <div class="shell" data-revelar>
        <p class="eyebrow" id="clientes-titulo">{clientesTitulo}</p>
      </div>
      {/* Os cinco logos somam ~557px. Meia volta com duas cópias não cobre
          1280px e abriria buraco no laço, então cada ciclo tem três cópias e
          o trilho leva dois ciclos — a animação desloca -50% e a emenda cai
          exatamente onde a segunda começa. */}
      <div class="marquee" role="group" aria-label="Clientes atendidos pela Etec">
        <div class="marquee-trilho">
          {
            Array.from({ length: 6 }, (_, ciclo) =>
              clientes.map((cliente) => (
                <img
                  src={`${base}/img/clientes/${cliente.arquivo}`}
                  alt={ciclo === 0 ? cliente.nome : ""}
                  aria-hidden={ciclo === 0 ? undefined : "true"}
                  height="300"
                  loading="lazy"
                  decoding="async"
                />
              )),
            )
          }
        </div>
      </div>
    </section>

    <section class="secao secao-papel" id="servicos" aria-labelledby="servicos-titulo">
      <div class="shell">
        <div class="secao-cabeca" data-revelar>
          <p class="eyebrow">Serviços</p>
          <h2 class="titulo" id="servicos-titulo">
            <span>Seis frentes,</span><span>um escritório só.</span>
          </h2>
        </div>

        <div class="servicos">
          {
            servicos.map((servico) => (
              <article class="servico" data-revelar>
                <div class="servico-topo">
                  <span class="servico-icone"><Icone nome={servico.icone} /></span>
                  <small>{servico.n}</small>
                </div>
                <h3>{servico.nome}</h3>
                <p>{servico.resumo}</p>
                <ul>
                  {servico.itens.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao secao-escura" id="sobre" aria-labelledby="sobre-titulo">
      <div class="shell sobre-grade">
        <div class="sobre-texto" data-revelar>
          <p class="eyebrow">{sobre.eyebrow}</p>
          <h2 class="titulo" id="sobre-titulo">
            {sobre.titulo.map((linha) => <span>{linha}</span>)}
          </h2>
          <div style="margin-top: 34px">
            {sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
          </div>
        </div>

        <div class="pilares" data-revelar>
          {
            pilares.map((pilar) => (
              <div class="pilar">
                <strong>{pilar.rotulo}</strong>
                <p>{pilar.texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao" id="depoimentos" aria-labelledby="depoimentos-titulo">
      <div class="shell">
        <div class="secao-cabeca" data-revelar>
          <p class="eyebrow">{depoimentosCabeca.eyebrow}</p>
          <h2 class="titulo" id="depoimentos-titulo">
            {depoimentosCabeca.titulo.map((linha) => <span>{linha}</span>)}
          </h2>
        </div>

        <div class="depoimentos">
          {
            depoimentos.map((dep) => (
              <figure class="depoimento" data-revelar>
                <blockquote>{dep.texto}</blockquote>
                <figcaption>
                  <b>{dep.autor}</b>
                  <span>{dep.papel}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao secao-escura" id="contato" aria-labelledby="contato-titulo">
      <div class="shell contato-grade">
        <div data-revelar>
          <p class="eyebrow">{contato.eyebrow}</p>
          <h2 class="titulo" id="contato-titulo">
            {contato.titulo.map((linha) => <span>{linha}</span>)}
          </h2>
          <p class="apoio">{contato.apoio}</p>
          <div class="hero-acoes">
            <a class="btn" href={linkWhatsapp("os serviços da Etec")} target="_blank" rel="noopener noreferrer">
              Chamar no WhatsApp<i aria-hidden="true"><Icone nome="zap" size={17} /></i>
            </a>
          </div>
        </div>

        <dl class="contato-dados" data-revelar>
          <div>
            <dt>Endereço</dt>
            <dd>{empresa.endereco}<br />{empresa.bairro} · {empresa.cidade} — {empresa.uf}</dd>
          </div>
          <div>
            <dt>Telefones</dt>
            <dd>
              {empresa.telefones.join(" · ")}<br />
              {empresa.whatsappExibicao} (WhatsApp)
            </dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${empresa.email}`}>{empresa.email}</a></dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="shell rodape-in">
      <span>© {new Date().getFullYear()} {empresa.nomeCompleto}</span>
      <span>{empresa.cidade} — {empresa.uf}</span>
      <span class="direita">Demonstração de redesign · não é o site oficial</span>
    </div>
  </footer>
</Layout>

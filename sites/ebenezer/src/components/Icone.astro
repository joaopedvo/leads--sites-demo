---
import { desenhos, type NomeIcone } from "./icones";

interface Props {
  nome: NomeIcone;
  size?: number;
  class?: string;
}

const { nome, size = 24, class: classe } = Astro.props;
---

<svg
  class={classe}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={desenhos[nome]}
/>

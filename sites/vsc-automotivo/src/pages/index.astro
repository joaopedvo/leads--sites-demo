---
import Layout from '../layouts/Layout.astro';

const whatsapp = 'mailto:hello@summit-demo.example?subject=Appointment%20request';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const asset = (path: string) => `${basePath}/${path}`;
const services = [
  ['01', 'General repair', 'Routine maintenance and repairs tailored to your vehicle.'],
  ['02', 'Brakes & suspension', 'Careful checks for stopping power, stability and ride comfort.'],
  ['03', 'Alignment & balancing', 'Smoother handling and more even tire wear.'],
  ['04', 'Electrical & diagnostics', 'System testing to help identify electrical and electronic issues.'],
  ['05', 'Oil & filters', 'The right oil and filters for your engine and maintenance schedule.'],
  ['06', 'Air conditioning', 'Keep your cabin comfortable with AC checks and maintenance.']
];
---

<Layout title="Summit Auto Care | Auto Repair in Portland, OR" description="A fictional Portland auto repair shop. Explore maintenance, diagnostics and repair services in this website concept.">
  <div class="demo-bar"><span>Website concept</span><b>Fictional business · sample information for demonstration only</b></div>

  <div class="site-loader" aria-hidden="true">
    <div class="loader-inner">
      <img class="loader-logo" src={asset('images/demo-logo.svg')} alt="" />
      <div class="loader-line"><span></span></div>
      <small>Auto repair · Portland, OR</small>
    </div>
  </div>

  <header class="header" data-header>
    <a href="#inicio" class="logo" aria-label="Summit — home"><img src={asset('images/demo-logo.svg')} alt="Summit Auto Care" /></a>
    <nav aria-label="Main navigation">
      <a href="#sobre">About Summit</a><a href="#servicos">Services</a><a href="#processo">How it works</a><a href="#contato">Contact</a>
    </nav>
    <a href={whatsapp} class="nav-cta" target="_blank" rel="noopener">Book now <span>↗</span></a>
    <button class="menu" aria-label="Open menu" aria-expanded="false"><i></i><i></i></button>
  </header>

  <main>
    <section class="hero" id="inicio">
      <div class="hero-copy">
        <p class="kicker" data-reveal><span></span> Independent auto repair · Portland, OR</p>
        <h1><span data-line>Precision for</span><span data-line>your car.</span><span data-line><em>Confidence</em> for you.</span></h1>
        <div class="hero-note" data-reveal>
          <p>Clear diagnostics, thoughtful repairs and personal attention to keep your everyday journeys running smoothly.</p>
          <a href={whatsapp} target="_blank" rel="noopener">Book an inspection <b>↗</b></a>
        </div>
      </div>
      <div class="hero-visual">
        <img src={asset('images/hero-oficina.webp')} alt="A vehicle being inspected in a modern auto repair shop" fetchpriority="high" />
        <div class="hero-badge"><strong>Care</strong><span>for every<br/>mile</span></div>
        <p>Diagnostics · Repairs · Confidence</p>
      </div>
      <a href="#sobre" class="scroll">Scroll to explore <span>↓</span></a>
    </section>

    <section class="manifesto" id="sobre">
      <div class="section-label" data-reveal>01 <span>About Summit</span></div>
      <div class="manifesto-copy">
        <h2 data-reveal>Your car deserves more than promises. It deserves <em>the right care.</em></h2>
        <div class="manifesto-text" data-reveal>
          <p>At Summit, every service starts with a conversation and a careful inspection. We explain what needs attention, why it matters and what it costs before you approve the work.</p>
          <p>That is our approach to lasting relationships in Portland: honest communication, careful work and respect for your time.</p>
        </div>
      </div>
    </section>

    <section class="image-break" aria-label="Professional vehicle diagnostics">
      <img src={asset('images/diagnostico.jpg')} alt="Technicians running electronic diagnostics on a vehicle" loading="lazy" data-parallax />
      <div class="image-caption"><span>Understand the problem first</span><p>The right tools help us find the issue. Careful judgment helps us plan the repair.</p></div>
    </section>

    <section class="services" id="servicos">
      <div class="services-head">
        <div class="section-label" data-reveal>02 <span>Services</span></div>
        <h2 data-reveal>From everyday maintenance to a deeper diagnosis.</h2>
        <p data-reveal>A full-service shop focused on the performance, comfort and confidence you expect from your car.</p>
      </div>
      <div class="services-layout">
        <div class="service-list">
          {services.map(([number, title, text]) => (
            <article class="service-row" data-reveal>
              <span>{number}</span><h3>{title}</h3><p>{text}</p><b>↗</b>
            </article>
          ))}
        </div>
        <aside class="service-photo" data-reveal>
          <img src={asset('images/servico-freios.webp')} alt="Professional brake system maintenance" loading="lazy" />
          <div><span>Care in every detail</span><strong>Ready for the moments when your car matters most.</strong></div>
        </aside>
      </div>
    </section>

    <section class="promise">
      <p class="kicker" data-reveal><span></span> The Summit approach</p>
      <h2 data-reveal>No guesswork.<br/>No runaround.<br/><em>Just clarity.</em></h2>
      <div class="promise-items">
        <div data-reveal><b>01</b><h3>Careful inspection</h3><p>We investigate the symptoms before recommending a repair.</p></div>
        <div data-reveal><b>02</b><h3>Straight answers</h3><p>You get a clear explanation and choose how to move forward.</p></div>
        <div data-reveal><b>03</b><h3>Thoughtful workmanship</h3><p>We work carefully and check the details before handing back your keys.</p></div>
      </div>
    </section>

    <section class="process" id="processo">
      <div class="process-title"><div class="section-label" data-reveal>03 <span>How it works</span></div><h2 data-reveal>From first hello to back on the road.</h2></div>
      <ol>
        <li data-reveal><span>01</span><strong>Get in touch</strong><p>Tell us what you have noticed about your vehicle.</p></li>
        <li data-reveal><span>02</span><strong>Schedule an inspection</strong><p>Find a convenient time to bring your car in.</p></li>
        <li data-reveal><span>03</span><strong>Approve the work</strong><p>Review the recommendation and estimate before we start.</p></li>
        <li data-reveal><span>04</span><strong>Drive with confidence</strong><p>Pick up your car with a clear explanation of the completed work.</p></li>
      </ol>
    </section>

    <section class="contact" id="contato">
      <div class="contact-copy">
        <p class="kicker" data-reveal><span></span> Book your inspection</p>
        <h2 data-reveal>Peace of mind starts with <em>a closer look.</em></h2>
        <p class="contact-intro" data-reveal>Tell us what is happening with your car. The Summit team will help you plan the next step and find an appointment.</p>
        <a class="contact-action" href={whatsapp} target="_blank" rel="noopener" data-reveal><span>Request an appointment</span><b>↗</b></a>
      </div>
      <div class="contact-visual" data-reveal>
        <img src={asset('images/veiculo-vsc.png')} alt="A vehicle receiving maintenance in an auto shop" loading="lazy" />
        <div class="contact-card">
          <div><small>Contact</small><strong>(503) 555-0131</strong></div>
          <div><small>Hours</small><strong>Mon–Fri · 8:00 AM–6:00 PM</strong></div>
          <div><small>Address</small><strong>480 Example Drive · Portland, OR</strong></div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="footer-main">
      <img src={asset('images/demo-logo.svg')} alt="Summit Auto Care" />
      <p>480 Example Drive<br/>Portland, OR 97205</p>
      <p><a href="tel:+15035550132">(503) 555-0132</a><br/><a href="mailto:hello@summit-demo.example">hello@summit-demo.example</a></p>
      <p>Independent auto care<br/>Portland, Oregon</p>
    </div>
    <div class="footer-meta"><span>© 2026 Summit Auto Care</span><span>Fictional business · website demonstration</span></div>
  </footer>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    const header = document.querySelector('[data-header]');
    const menu = document.querySelector('.menu');
    menu?.addEventListener('click', () => {
      const open = document.body.classList.toggle('menu-open');
      menu.setAttribute('aria-expanded', String(open));
    });
    document.querySelectorAll('nav a').forEach(a => a.addEventListener('click', () => document.body.classList.remove('menu-open')));
    addEventListener('scroll', () => header?.classList.toggle('scrolled', scrollY > 30), { passive: true });

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.body.classList.add('ready');

    if (reduceMotion) {
      gsap.set('.site-loader', { display: 'none' });
      gsap.set('[data-reveal], [data-line]', { clearProps: 'all', autoAlpha: 1 });
    } else {
      gsap.set(document.body, { overflow: 'hidden' });
      const intro = gsap.timeline({ defaults: { ease: 'power4.out' } });
      intro
        .to('.loader-line span', { scaleX: 1, duration: .7, ease: 'power2.inOut' })
        .to('.loader-logo, .loader-inner small', { y: -10, autoAlpha: 0, duration: .35, stagger: .04 }, '+=.08')
        .to('.site-loader', { yPercent: -100, duration: .7, ease: 'power4.inOut' })
        .set('.site-loader', { display: 'none' })
        .set(document.body, { clearProps: 'overflow' })
        .fromTo('.header', { y: -28, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .7 })
        .fromTo('[data-line]', { y: 58, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .9, stagger: .09, clearProps: 'transform', }, '-=.45')
        .fromTo('.hero .kicker, .hero-note', { y: 24, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: .8, stagger: .12 }, '-=.65')
        .fromTo('.hero-visual', { clipPath: 'inset(0 100% 0 0)' }, { clipPath: 'inset(0 0% 0 0)', duration: 1.2 }, '-=.9')
        .fromTo('.hero-badge', { scale: 0, rotate: -28 }, { scale: 1, rotate: -8, duration: .7, ease: 'back.out(1.6)' }, '-=.35');

      gsap.utils.toArray('[data-reveal]').forEach((element) => {
        if (element.closest('.hero')) return;
        gsap.fromTo(element,
          { y: 44, autoAlpha: 0 },
          { y: 0, autoAlpha: 1, duration: .85, ease: 'power3.out', scrollTrigger: { trigger: element, start: 'top 88%', once: true } }
        );
      });

      gsap.utils.toArray('.manifesto h2, .services-head h2, .promise h2, .process-title h2, .contact h2').forEach((title) => {
        gsap.fromTo(title,
          { clipPath: 'inset(0 0 100% 0)', y: 34 },
          { clipPath: 'inset(0 0 0% 0)', y: 0, duration: 1.05, ease: 'power4.out', scrollTrigger: { trigger: title, start: 'top 84%', once: true } }
        );
      });

      gsap.utils.toArray('.image-break, .service-photo, .contact-visual').forEach((frame) => {
        const image = frame.querySelector('img');
        if (!image) return;
        gsap.fromTo(frame,
          { clipPath: 'inset(0 0 18% 0)' },
          { clipPath: 'inset(0 0 0% 0)', duration: 1, ease: 'power3.out', scrollTrigger: { trigger: frame, start: 'top 84%', once: true } }
        );
        gsap.fromTo(image,
          { scale: 1.12, yPercent: -2 },
          { scale: 1.03, yPercent: 2, ease: 'none', scrollTrigger: { trigger: frame, start: 'top bottom', end: 'bottom top', scrub: 1.1 } }
        );
      });

      gsap.fromTo('.service-row',
        { x: -28, autoAlpha: 0 },
        { x: 0, autoAlpha: 1, duration: .65, stagger: .08, ease: 'power3.out', scrollTrigger: { trigger: '.service-list', start: 'top 82%', once: true } }
      );
      gsap.fromTo('.promise-items > div',
        { y: 42, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: .75, stagger: .14, ease: 'power3.out', scrollTrigger: { trigger: '.promise-items', start: 'top 84%', once: true } }
      );
      gsap.fromTo('.process li',
        { y: 36, autoAlpha: 0 },
        { y: 0, autoAlpha: 1, duration: .7, stagger: .12, ease: 'power3.out', scrollTrigger: { trigger: '.process ol', start: 'top 86%', once: true } }
      );

      gsap.to('.hero-visual img', {
        scale: 1.08,
        yPercent: 4,
        ease: 'none',
        scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: 1 }
      });

      document.querySelectorAll('.nav-cta, .hero-note a, .contact-action').forEach((button) => {
        const moveX = gsap.quickTo(button, 'x', { duration: .35, ease: 'power3.out' });
        const moveY = gsap.quickTo(button, 'y', { duration: .35, ease: 'power3.out' });
        const arrow = button.querySelector('b, span:last-child');
        button.addEventListener('pointermove', (event) => {
          const rect = button.getBoundingClientRect();
          moveX((event.clientX - rect.left - rect.width / 2) * .08);
          moveY((event.clientY - rect.top - rect.height / 2) * .12);
        });
        button.addEventListener('pointerenter', () => arrow && gsap.to(arrow, { x: 5, y: -5, duration: .25 }));
        button.addEventListener('pointerleave', () => {
          moveX(0); moveY(0);
          if (arrow) gsap.to(arrow, { x: 0, y: 0, duration: .3 });
        });
      });
    }
  </script>
</Layout>

---
import { desenhos, type NomeIcone } from "./icones";

interface Props {
  nome: NomeIcone;
  size?: number;
}

const { nome, size = 21 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={desenhos[nome]}
/>

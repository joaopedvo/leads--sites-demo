---
import Layout from "../layouts/Layout.astro";
import Icone from "../components/Icone.astro";
import {
  empresa,
  linkWhatsapp,
  hero,
  fatos,
  servicos,
  sobre,
  pilares,
  contato,
} from "../data/conteudo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${empresa.nomeCompleto} — Accounting in ${empresa.cidade}, ${empresa.uf}`}
  description="A fictional Charlotte accounting firm offering a website concept for bookkeeping, business and individual support."
>
  <header class="topo">
    <div class="shell topo-in">
      <img src={`${base}/img/demo-logo.svg`} alt={empresa.nomeCompleto} width="240" height="80" />
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="menu-principal">
        <span></span><span></span><span></span>
      </button>
      <nav id="menu-principal" aria-label="Main navigation">
        <a href="#inicio">Home</a>
        <a href="#servicos">Services</a>
        <a href="#sobre">About us</a>
        <a href="#depoimentos">Testimonials</a>
        <a class="nav-cta" href="#contato">Contact</a>
      </nav>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero" id="inicio">
      <div class="shell">
        <div class="hero-grade">
          <div data-revelar>
            <p class="eyebrow">{hero.eyebrow}</p>
            <h1 class="titulo">{hero.titulo.map((linha) => <span>{linha}</span>)}</h1>
          </div>
          <div data-revelar>
            <p class="hero-selo"><strong>Since 1998</strong><span>accounting in<br />Charlotte, NC</span></p>
            <p class="apoio">{hero.apoio}</p>
            <div class="hero-acoes">
              <a class="btn" href={linkWhatsapp("setting up my business")} target="_blank" rel="noopener noreferrer">
                {hero.cta}<i aria-hidden="true"><Icone nome="documento" size={17} /></i>
              </a>
              <a class="btn btn--vazado" href="#servicos">
                {hero.ctaSecundario}<i class="btn-mais" aria-hidden="true">+</i>
              </a>
            </div>
          </div>
        </div>

        <div class="fatos" data-revelar>
          {
            fatos.map((fato) => (
              <div>
                <strong>
                  {fato.valor}
                  
                </strong>
                <span>{fato.rotulo}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>




    <section class="secao secao-papel" id="servicos" aria-labelledby="servicos-titulo">
      <div class="shell">
        <div class="secao-cabeca" data-revelar>
          <p class="eyebrow">Services</p>
          <h2 class="titulo" id="servicos-titulo">
            <span>Six services,</span><span>one familiar team.</span>
          </h2>
        </div>

        <div class="servicos">
          {
            servicos.map((servico) => (
              <article class="servico" data-revelar>
                <div class="servico-topo">
                  <span class="servico-icone"><Icone nome={servico.icone} /></span>
                  <small>{servico.n}</small>
                </div>
                <h3>{servico.nome}</h3>
                <p>{servico.resumo}</p>
                <ul>
                  {servico.itens.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao secao-escura" id="sobre" aria-labelledby="sobre-titulo">
      <div class="shell sobre-grade">
        <div class="sobre-texto" data-revelar>
          <p class="eyebrow">{sobre.eyebrow}</p>
          <h2 class="titulo" id="sobre-titulo">
            {sobre.titulo.map((linha) => <span>{linha}</span>)}
          </h2>
          <div style="margin-top: 34px">
            {sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
          </div>
        </div>

        <div class="pilares" data-revelar>
          {
            pilares.map((pilar) => (
              <div class="pilar">
                <strong>{pilar.rotulo}</strong>
                <p>{pilar.texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>



    <section class="secao" id="depoimentos" aria-labelledby="depoimentos-titulo">
      <div class="shell">
        <div class="secao-cabeca">
          <p class="eyebrow">Sample testimonials</p>
          <h2 class="titulo" id="depoimentos-titulo"><span>Personal attention</span><span>makes a difference.</span></h2>
          <p class="apoio">Fictional testimonials shown to demonstrate this layout. These are not real customer reviews.</p>
        </div>
        <div class="depoimentos">
          <figure class="depoimento">
            <blockquote>“Starting my business came with plenty of questions. Having each step explained clearly made the whole process feel more manageable.”</blockquote>
            <figcaption><b>Emily · fictional customer</b><span>Sample — business setup</span></figcaption>
          </figure>
          <figure class="depoimento">
            <blockquote>“With my records organized and a clearer monthly routine, it became much easier to understand what was happening in my business.”</blockquote>
            <figcaption><b>Michael · fictional customer</b><span>Sample — monthly bookkeeping</span></figcaption>
          </figure>
          <figure class="depoimento">
            <blockquote>“I finally understood which documents to gather and had a chance to ask the questions that had been on my mind.”</blockquote>
            <figcaption><b>Sarah · fictional customer</b><span>Sample — document preparation</span></figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section class="secao secao-escura" id="contato" aria-labelledby="contato-titulo">
      <div class="shell contato-grade">
        <div data-revelar>
          <p class="eyebrow">{contato.eyebrow}</p>
          <h2 class="titulo" id="contato-titulo">
            {contato.titulo.map((linha) => <span>{linha}</span>)}
          </h2>
          <p class="apoio">{contato.apoio}</p>
          <div class="hero-acoes">
            <a class="btn" href={linkWhatsapp("Westbrook services")} target="_blank" rel="noopener noreferrer">
              Send an email<i aria-hidden="true"><Icone nome="documento" size={17} /></i>
            </a>
          </div>
        </div>

        <dl class="contato-dados" data-revelar>
          <div>
            <dt>Address</dt>
            <dd>{empresa.endereco}<br />{empresa.cidade} — {empresa.uf}<br />ZIP {empresa.cep}</dd>
          </div>
          <div>
            <dt>Phone numbers</dt>
            <dd>
              {empresa.telefones.join(" · ")}<br />
              {empresa.whatsappExibicao} (Office)
            </dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${empresa.email}`}>{empresa.email}</a></dd>
          </div>
          <div><dt>Service</dt><dd>{empresa.horario}</dd></div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="shell rodape-in">
      <span>© {new Date().getFullYear()} {empresa.nomeCompleto}</span>
      <span>{empresa.cidade} — {empresa.uf}</span>
      <span class="direita">Fictional business · website demonstration</span>
    </div>
  </footer>
</Layout>




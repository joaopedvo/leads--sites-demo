---
import Layout from "../layouts/Layout.astro";
import Icone from "../components/Icone.astro";
import {
  empresa,
  linkWhatsapp,
  hero,
  fatos,
  servicos,
  sobre,
  pilares,
  contato,
} from "../data/conteudo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
  title={`${empresa.nomeCompleto} — Contabilidade em ${empresa.cidade}, ${empresa.uf}`}
  description="JVN Contabilidade em Uberlândia desde 1986. Abertura e encerramento de empresas, escrituração contábil e fiscal, rotinas trabalhistas e Imposto de Renda."
>
  <header class="topo">
    <div class="shell topo-in">
      <img src={`${base}/img/logo-jvn-transparente.png`} alt={empresa.nomeCompleto} width="100" height="100" />
      <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
        <span></span><span></span><span></span>
      </button>
      <nav id="menu-principal" aria-label="Navegação principal">
        <a href="#inicio">Início</a>
        <a href="#servicos">Serviços</a>
        <a href="#sobre">Quem somos</a>
        <a href="#depoimentos">Depoimentos</a>
        <a class="nav-cta" href="#contato">Contato</a>
      </nav>
    </div>
  </header>

  <main id="conteudo">
    <section class="hero" id="inicio">
      <div class="shell">
        <div class="hero-grade">
          <div data-revelar>
            <p class="eyebrow">{hero.eyebrow}</p>
            <h1 class="titulo">{hero.titulo.map((linha) => <span>{linha}</span>)}</h1>
          </div>
          <div data-revelar>
            <p class="hero-selo"><strong>Desde 1986</strong><span>contabilidade em<br />Uberlândia, MG</span></p>
            <p class="apoio">{hero.apoio}</p>
            <div class="hero-acoes">
              <a class="btn" href={linkWhatsapp("abrir minha empresa")} target="_blank" rel="noopener noreferrer">
                {hero.cta}<i aria-hidden="true"><Icone nome="zap" size={17} /></i>
              </a>
              <a class="btn btn--vazado" href="#servicos">
                {hero.ctaSecundario}<i class="btn-mais" aria-hidden="true">+</i>
              </a>
            </div>
          </div>
        </div>

        <div class="fatos" data-revelar>
          {
            fatos.map((fato) => (
              <div>
                <strong>
                  {fato.valor}
                  
                </strong>
                <span>{fato.rotulo}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>




    <section class="secao secao-papel" id="servicos" aria-labelledby="servicos-titulo">
      <div class="shell">
        <div class="secao-cabeca" data-revelar>
          <p class="eyebrow">Serviços</p>
          <h2 class="titulo" id="servicos-titulo">
            <span>Seis frentes,</span><span>um escritório só.</span>
          </h2>
        </div>

        <div class="servicos">
          {
            servicos.map((servico) => (
              <article class="servico" data-revelar>
                <div class="servico-topo">
                  <span class="servico-icone"><Icone nome={servico.icone} /></span>
                  <small>{servico.n}</small>
                </div>
                <h3>{servico.nome}</h3>
                <p>{servico.resumo}</p>
                <ul>
                  {servico.itens.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="secao secao-escura" id="sobre" aria-labelledby="sobre-titulo">
      <div class="shell sobre-grade">
        <div class="sobre-texto" data-revelar>
          <p class="eyebrow">{sobre.eyebrow}</p>
          <h2 class="titulo" id="sobre-titulo">
            {sobre.titulo.map((linha) => <span>{linha}</span>)}
          </h2>
          <div style="margin-top: 34px">
            {sobre.paragrafos.map((paragrafo) => <p>{paragrafo}</p>)}
          </div>
        </div>

        <div class="pilares" data-revelar>
          {
            pilares.map((pilar) => (
              <div class="pilar">
                <strong>{pilar.rotulo}</strong>
                <p>{pilar.texto}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>



    <section class="secao" id="depoimentos" aria-labelledby="depoimentos-titulo">
      <div class="shell">
        <div class="secao-cabeca">
          <p class="eyebrow">Depoimentos de exemplo</p>
          <h2 class="titulo" id="depoimentos-titulo"><span>Atendimento que</span><span>faz a diferença.</span></h2>
          <p class="apoio">Relatos fictícios para demonstrar esta seção. Não representam clientes ou avaliações reais da JVN.</p>
        </div>
        <div class="depoimentos">
          <figure class="depoimento">
            <blockquote>“Na abertura da minha empresa, eu tinha muitas dúvidas. Ter alguém explicando cada etapa com clareza tornou o processo muito mais tranquilo.”</blockquote>
            <figcaption><b>Mariana · personagem fictícia</b><span>Exemplo — abertura de empresa</span></figcaption>
          </figure>
          <figure class="depoimento">
            <blockquote>“Com os documentos organizados e as orientações sobre a rotina fiscal, ficou mais fácil acompanhar as obrigações do meu negócio.”</blockquote>
            <figcaption><b>Ricardo · personagem fictício</b><span>Exemplo — rotina contábil e fiscal</span></figcaption>
          </figure>
          <figure class="depoimento">
            <blockquote>“Consegui entender quais documentos precisava reunir para o Imposto de Renda e esclarecer minhas dúvidas durante o atendimento.”</blockquote>
            <figcaption><b>Fernanda · personagem fictícia</b><span>Exemplo — Imposto de Renda</span></figcaption>
          </figure>
        </div>
      </div>
    </section>
    <section class="secao secao-escura" id="contato" aria-labelledby="contato-titulo">
      <div class="shell contato-grade">
        <div data-revelar>
          <p class="eyebrow">{contato.eyebrow}</p>
          <h2 class="titulo" id="contato-titulo">
            {contato.titulo.map((linha) => <span>{linha}</span>)}
          </h2>
          <p class="apoio">{contato.apoio}</p>
          <div class="hero-acoes">
            <a class="btn" href={linkWhatsapp("os serviços da JVN")} target="_blank" rel="noopener noreferrer">
              Chamar no WhatsApp<i aria-hidden="true"><Icone nome="zap" size={17} /></i>
            </a>
          </div>
        </div>

        <dl class="contato-dados" data-revelar>
          <div>
            <dt>Endereço</dt>
            <dd>{empresa.endereco}<br />{empresa.cidade} — {empresa.uf}<br />CEP {empresa.cep}</dd>
          </div>
          <div>
            <dt>Telefones</dt>
            <dd>
              {empresa.telefones.join(" · ")}<br />
              {empresa.whatsappExibicao} (WhatsApp)
            </dd>
          </div>
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${empresa.email}`}>{empresa.email}</a></dd>
          </div>
          <div><dt>Atendimento</dt><dd>{empresa.horario}</dd></div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <div class="shell rodape-in">
      <span>© {new Date().getFullYear()} {empresa.nomeCompleto}</span>
      <span>{empresa.cidade} — {empresa.uf}</span>
      <span class="direita">Demonstração de redesign · não é o site oficial</span>
    </div>
  </footer>
</Layout>




---
import { hero, empresa, provas, linkWhatsapp } from "../data/conteudo";
import Icone from "./Icone.astro";
import type { NomeIcone } from "./icones";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// "21 serviços" é a prova mais distintiva — vira a peça gráfica do painel.
// As outras duas ficam pequenas, de apoio. Os canais de contato não repetem
// aqui: já estão nos botões do Hero, no cabeçalho e no rodapé.
const destaque = provas[2];
const resto = [provas[0], provas[1]];
---

<section class="hero secao--papel" id="topo">
  <div class="container hero__grade">
    <div class="hero__texto">
      <span class="rotulo rotulo--marcado" data-surge>{hero.rotulo}</span>

      <h1 class="d1 hero__titulo" data-texto>
        {
          hero.tituloPartes.map((parte, i) => (
            <>
              {i > 0 && " "}
              {parte.italico ? <em class="italico">{parte.texto}</em> : parte.texto}
            </>
          ))
        }
      </h1>

      <p class="corpo-g hero__lead" data-surge style="--atraso: 140ms">
        {hero.subtitulo}
      </p>

      <div class="hero__acoes" data-surge style="--atraso: 220ms">
        <a class="btn btn--escuro" href={linkWhatsapp()} target="_blank" rel="noopener">
          {hero.ctaPrimario}
          <span class="btn__seta" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--contorno" href={`${base}/#servicos`}>
          {hero.ctaSecundario}
          <span class="btn__seta" aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <!--
      Sem foto do escritório, a coluna direita é uma peça gráfica — um número
      grande, não um card de contato. Mesmo peso visual da foto do Auria, sem
      recorrer a imagem de banco nem repetir os canais que já estão nos
      botões do Hero, no cabeçalho e no rodapé.
    -->
    <aside class="cartao secao--escura" data-surge="escala" style="--atraso: 180ms">
      <div class="cartao__topo">
        <span class="pilula pilula--acento">Atendimento</span>
        <span class="rotulo">
          {empresa.cidade}/{empresa.uf}
        </span>
      </div>

      <div class="cartao__destaque">
        <span class="badge badge--acento" aria-hidden="true">
          <Icone nome={destaque.icone as NomeIcone} size={19} />
        </span>
        <span class="cartao__numero" aria-label={`${destaque.valor}${destaque.sufixo} ${destaque.rotulo}`}>
          <span aria-hidden="true" data-conta={destaque.valor} data-sufixo={destaque.sufixo}>
            {destaque.valor}{destaque.sufixo}
          </span>
        </span>
        <span class="rotulo">{destaque.rotulo}</span>
        <p class="corpo cartao__legenda">Da terceirização fiscal ao diagnóstico financeiro.</p>
      </div>

      <hr class="regua" />

      <div class="cartao__rodape">
        <ul class="cartao__provas">
          {
            resto.map((p) => (
              <li>
                <span class="cartao__provasValor" aria-label={`${p.valor}${p.sufixo} ${p.rotulo}`}>
                  <span aria-hidden="true" data-conta={p.valor} data-sufixo={p.sufixo}>
                    {p.valor}{p.sufixo}
                  </span>
                </span>
                <span class="rotulo">{p.rotulo}</span>
              </li>
            ))
          }
        </ul>

        <p class="cartao__nota">
          <Icone nome="pino" size={15} />
          {empresa.endereco} — {empresa.bairro}
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--e5);
    padding-bottom: var(--e6);
  }

  .hero__grade {
    display: grid;
    gap: var(--e4);
    align-items: stretch;
  }

  .hero__texto {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--e3);
  }

  /* título curto: cabe numa linha em desktop, duas no celular */
  .hero__titulo {
    max-width: 12ch;
  }

  .hero__lead {
    max-width: 38ch;
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .cartao {
    position: relative;
    display: grid;
    align-content: space-between;
    gap: var(--e3);
    padding: var(--e4) var(--e3) var(--e3);
    border-radius: var(--r-xl);
    box-shadow: var(--sombra-flutua);
    min-height: 420px;
  }

  .cartao__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e2);
  }

  .cartao .badge {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--texto-claro);
  }

  /* badge--acento é branco cheio: o ícone precisa ficar escuro, não claro */
  .cartao .badge--acento {
    color: var(--tinta-950);
  }

  /* peça gráfica central: número grande, não lista de contato */
  .cartao__destaque {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: 0.3rem;
    padding-block: var(--e3);
  }

  .cartao__numero {
    display: block;
    font-family: var(--serif);
    font-size: clamp(4.5rem, 3.6rem + 3.5vw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    margin-top: 0.9rem;
  }

  .cartao__legenda {
    margin-top: 0.7rem;
    max-width: 26ch;
    color: var(--texto-claro-suave);
  }

  .cartao__rodape {
    display: grid;
    gap: var(--e3);
  }

  .cartao__provas {
    display: flex;
    gap: var(--e4);
  }

  .cartao__provasValor {
    display: block;
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    margin-bottom: 0.2rem;
  }

  .cartao__provas .rotulo {
    color: var(--texto-claro-suave);
  }

  .cartao__nota {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--texto-claro-suave);
  }

  .cartao__nota :global(svg) {
    flex-shrink: 0;
  }

  @media (min-width: 940px) {
    .hero {
      padding-top: var(--e6);
    }

    .hero__grade {
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--e5);
    }

    .cartao {
      padding: var(--e4);
    }
  }
</style>

---
import { empresa, navegacao, canais } from "../data/conteudo";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const ano = new Date().getFullYear();
const href = (d: string) => (d.startsWith("#") ? `${base}/${d}` : `${base}${d}`);
---

<footer class="rodape secao--escura">
  <div class="container">
    <div class="rodape__grade">
      <div class="rodape__marca">
        <img
          src={`${base}/img/logo-as7.png`}
          alt={empresa.nomeCompleto}
          width="240"
          height="126"
          loading="lazy"
        />
        <p class="corpo rodape__descricao">
          Assessoria contábil, fiscal e financeira em {empresa.cidade} desde {empresa.fundacao}.
        </p>
      </div>

      <nav class="rodape__coluna" aria-label="Seções">
        <span class="rotulo">Navegar</span>
        <ul>
          {navegacao.map((item) => (
            <li><a class="rodape__link" href={href(item.href)}>{item.rotulo}</a></li>
          ))}
        </ul>
      </nav>

      <div class="rodape__coluna">
        <span class="rotulo">Contato</span>
        <ul>
          {canais.map((c) => (
            <li>
              <a
                class="rodape__link"
                href={c.href}
                target={c.externo ? "_blank" : undefined}
                rel={c.externo ? "noopener" : undefined}
              >
                {c.valor}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="rodape__coluna">
        <span class="rotulo">Escritório</span>
        <p class="rodape__endereco">
          {empresa.endereco}<br />
          {empresa.bairro} — CEP {empresa.cep}<br />
          {empresa.cidade} / {empresa.uf}
        </p>
        <p class="rodape__endereco">CNPJ {empresa.cnpj}</p>
      </div>
    </div>

    <hr class="regua" />

    <div class="rodape__base">
      <p>© {ano} {empresa.nomeCompleto}</p>
      <p class="rodape__aviso">Página de demonstração, sem vínculo oficial com a empresa.</p>
    </div>
  </div>
</footer>

<style>
  .rodape {
    padding-top: var(--e5);
  }

  .rodape__grade {
    display: grid;
    gap: var(--e4);
    padding-bottom: var(--e4);
  }

  @media (min-width: 760px) {
    .rodape__grade {
      grid-template-columns: 1.4fr 0.8fr 1fr 1.1fr;
      gap: var(--e3);
    }
  }

  .rodape__marca {
    display: grid;
    justify-items: start;
    gap: var(--e2);
  }

  /* o logo é cinza escuro; sobre fundo preto precisa clarear para aparecer */
  .rodape__marca img {
    height: 54px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .rodape__descricao {
    max-width: 30ch;
    font-size: 0.94rem;
  }

  .rodape__coluna {
    display: grid;
    align-content: start;
    gap: var(--e2);
  }

  .rodape__coluna ul {
    display: grid;
    gap: 0.55rem;
  }

  .rodape__link {
    font-size: 0.95rem;
    color: var(--texto-claro-suave);
    transition: color 0.3s var(--curva);
  }

  .rodape__link:hover {
    color: var(--texto-claro);
  }

  .rodape__endereco {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--texto-claro-suave);
  }

  .rodape__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--e1);
    padding-block: var(--e3);
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--cinza-500);
  }
</style>

---
const phoneDisplay = '(818) 322-6941';
const phoneHref = 'tel:+18183226941';
const email = 'sales@onestopscvhvac.com';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullLogo = `${base}/images/one-stop-logo-full-transparent.png`;
const iconLogo = `${base}/images/one-stop-icon-transparent.png`;
const heroImage = `${base}/images/hero-hvac-technicians.png`;

const services = [
  ['AC Repair & Service', 'Fast, reliable air conditioning troubleshooting and repair for residential and commercial systems.', 'svc-ac-repair.jpg'],
  ['Heating & Furnace', 'Professional heating and furnace repair, maintenance, and installation for year-round comfort.', 'svc-heating-furnace.jpg'],
  ['HVAC Installation', 'Complete system installation and replacement with quality equipment and professional workmanship.', 'svc-hvac-installation.jpg'],
  ['Mini Splits', 'Efficient ductless heating and cooling for additions, garages, and properties without ductwork.', 'svc-mini-splits.jpg']
];

const serviceOptions = [
  'AC Repair & Services',
  'Heating & Furnace',
  'HVAC Installation',
  'Mini Splits',
  'Other'
];
const timelineOptions = [
  'Emergency (today)',
  'Within a few days',
  'Just getting a quote'
];

const whyUs = [
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
    title: 'Licensed, Bonded & Insured',
    text: 'Fully licensed (CSLB #1159265), bonded, and insured for residential and commercial HVAC work.'
  },
  {
    icon: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.7 2.7-2-2 2.8-2.8z"/>',
    title: 'Experienced HVAC Professionals',
    text: 'Skilled technicians delivering reliable heating and cooling solutions for homes and businesses.'
  },
  {
    icon: '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 4H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="m9 14 2 2 4-4"/>',
    title: 'Free Estimates & Honest Advice',
    text: 'A free estimate and a clear recommendation for your system, with no pressure and no surprises.'
  }
];

const footerColumns = [
  {
    title: 'Explore',
    links: [['Home', '#top'], ['Services', '#services'], ['Why Us', '#why-us'], ['Request Service', '#request-service']]
  },
  {
    title: 'Services',
    links: [['AC Repair & Service', '#services'], ['Heating & Furnace', '#services'], ['HVAC Installation', '#services'], ['Mini Splits', '#services']]
  }
];

const socialLinks = [
  ['Facebook', '#', '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>'],
  ['Instagram', '#', '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>'],
  ['X', '#', '<path d="M4 4l16 16M20 4L4 20"/>'],
  ['LinkedIn', '#', '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>']
];

const buildYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Licensed, bonded, and insured HVAC contractor serving Santa Clarita Valley. AC repair, heating, mini splits, and HVAC installation. Free estimates." />
    <title>One-Stop Heating & Cooling | Santa Clarita, CA</title>
  </head>
  <body>
    <header>
      <a class="brand" href="#top" aria-label="One-Stop Heating & Cooling home">
        <img src={fullLogo} alt="One-Stop Heating & Cooling Inc." />
      </a>
      <nav aria-label="Primary navigation">
        <a class="active" href="#top">Home</a>
        <a href="#services">Services</a>
        <a href="#why-us">Why Us</a>
        <a href="#request-service">Contact</a>
      </nav>
      <div class="header-actions">
        <a class="header-phone" href={phoneHref}>☎ <span>{phoneDisplay}</span></a>
        <a class="button small dark" href="#request-service">Free Estimate</a>
      </div>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Santa Clarita Valley HVAC professionals</p>
          <h1>Home Comfort, <span>Simplified</span> for You.</h1>
          <p class="lead">Reliable heating, cooling, and mini split installation, repair, and maintenance for homes and businesses across Santa Clarita Valley.</p>
          <div class="trust-pills" aria-label="Company qualifications">
            <span>✓ Licensed</span>
            <span>✓ Bonded & Insured</span>
            <span>✓ Free Estimates</span>
          </div>
          <div class="actions">
            <a class="button" href="#services">View Services</a>
            <a class="secondary-button" href={phoneHref}>◉ Call {phoneDisplay}</a>
          </div>
        </div>
        <div class="hero-visual">
          <img class="hero-photo" src={heroImage} alt="Two HVAC technicians servicing an outdoor air-conditioning system" />
          <aside class="estimate-card">
            <div class="estimate-heading">
              <div>
                <span class="estimate-kicker">Quick request</span>
                <h2>Free Estimate</h2>
              </div>
              <img src={iconLogo} alt="" />
            </div>
            <div class="estimate-tabs" aria-label="Service type">
              <span class="selected">Residential</span>
              <span>Commercial</span>
            </div>
            <div class="estimate-field">
              <span>How can we help?</span>
              <strong>Choose an HVAC service</strong>
            </div>
            <p><strong>No-pressure estimate.</strong><br />Tell us what you need and our team will follow up.</p>
            <a class="button estimate-button" href="#request-service">Request My Estimate</a>
          </aside>
        </div>
      </section>

      <section id="services" class="section">
        <p class="eyebrow">Complete comfort solutions</p>
        <h2>Heating and Cooling, All in One Place</h2>
        <p class="intro">From a quick AC repair to a complete system installation, we handle it all with dependable service and professional workmanship.</p>
        <div class="services-accordion">
          {services.map(([title, description, photo], i) => (
            <article class="svc-panel" tabindex="0">
              <span class="svc-photo" style={`background-image: url('${base}/images/${photo}')`}></span>
              <span class="svc-veil"></span>
              <span class="svc-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
              </span>
              <div class="svc-body">
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="why-us" class="section why-us">
        <div class="why-us-lead">
          <div class="why-us-photo">
            <img src={heroImage} alt="One-Stop HVAC technicians servicing an outdoor air-conditioning unit" />
          </div>
          <div class="why-us-copy">
            <p class="eyebrow">Why choose One-Stop</p>
            <h2>Experienced technicians who handle every job with care and precision</h2>
            <p class="intro">From a quick AC repair to a complete system replacement, we deliver dependable workmanship, clear recommendations, and no surprises — for homes and businesses across Santa Clarita Valley.</p>
            <a class="button" href="#request-service">Get a Free Quote</a>
          </div>
        </div>
        <div class="why-us-features">
          {whyUs.map((item) => (
            <article>
              <span class="feature-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
              </span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="cta">
        <p class="eyebrow">Let's get your comfort back</p>
        <h2>Ready to Feel Comfortable Again?</h2>
        <p>Request service online or call to speak with an HVAC professional.</p>
        <div class="actions">
          <a class="button light" href="#request-service">Request Service</a>
          <a class="text-link light-link" href={phoneHref}>{phoneDisplay}</a>
        </div>
      </section>

      <section id="request-service" class="form-section">
        <div class="form-intro">
          <p class="eyebrow">Request Service</p>
          <h2>Tell Us What You Need</h2>
          <p class="intro">Send us the details and our team will get back to you with a free estimate. For urgent issues, call <a href={phoneHref}>{phoneDisplay}</a>.</p>
          <ul class="form-assurances">
            <li>Licensed, bonded &amp; insured · CSLB #1159265</li>
            <li>Residential &amp; commercial service</li>
            <li>Free estimates, no pressure</li>
          </ul>
        </div>

        <form class="request-form" novalidate>
          <p class="field">
            <label for="rf-name">Full Name <span aria-hidden="true">*</span></label>
            <input type="text" id="rf-name" name="full_name" autocomplete="name" required />
          </p>

          <div class="field-row">
            <p class="field">
              <label for="rf-phone">Phone <span aria-hidden="true">*</span></label>
              <input type="tel" id="rf-phone" name="phone" autocomplete="tel"
                inputmode="tel" pattern="[0-9()+\-.\s]{7,}"
                title="Enter a valid phone number (at least 7 digits)." required />
            </p>
            <p class="field">
              <label for="rf-email">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="rf-email" name="email" autocomplete="email" required />
            </p>
          </div>

          <p class="field">
            <label for="rf-address">Service Address <span aria-hidden="true">*</span></label>
            <input type="text" id="rf-address" name="service_address" autocomplete="street-address" required />
          </p>

          <div class="field-row">
            <p class="field">
              <label for="rf-property">Property Type <span aria-hidden="true">*</span></label>
              <select id="rf-property" name="property_type" required>
                <option value="" selected disabled>Select property type</option>
                <option value="Residential">Residential</option>
                <option value="Commercial">Commercial</option>
              </select>
            </p>
            <p class="field">
              <label for="rf-service">Service Needed <span aria-hidden="true">*</span></label>
              <select id="rf-service" name="service_needed" required>
                <option value="">Select a service</option>
                {serviceOptions.map((option) => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </p>
          </div>

          <p class="field">
            <label for="rf-timeline">How soon do you need service?</label>
            <select id="rf-timeline" name="service_timeline">
              <option value="" selected>No preference</option>
              {timelineOptions.map((option) => (
                <option value={option}>{option}</option>
              ))}
            </select>
          </p>

          <p class="field">
            <label for="rf-message">Message / Describe the issue</label>
            <textarea id="rf-message" name="message" rows="4"></textarea>
          </p>

          <button type="submit" class="button form-submit">Request a Free Estimate</button>

          <p class="form-confirmation" role="status" hidden>
            Thanks — your request has been sent. Our team will contact you shortly. For urgent issues, call <a href={phoneHref}>{phoneDisplay}</a>.
          </p>
        </form>
      </section>
    </main>

    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {Array.from({ length: 2 }).map(() => (
          <div class="marquee-group">
            {Array.from({ length: 5 }).map(() => (
              <span class="marquee-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                Call us today — {phoneDisplay}
                <span class="marquee-dot">•</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <footer class="site-footer">
      <div class="footer-grid">
        <div class="footer-brand">
          <img src={fullLogo} alt="One-Stop Heating & Cooling Inc." />
          <p>Reliable heating, cooling, and mini split service for homes and businesses across Santa Clarita Valley. Request a free estimate.</p>
          <div class="footer-socials">
            {socialLinks.map(([label, href, path]) => (
              <a href={href} aria-label={label}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={path} />
              </a>
            ))}
          </div>
        </div>

        {footerColumns.map((column) => (
          <div class="footer-col">
            <h4>{column.title}</h4>
            <ul>
              {column.links.map(([label, href], i) => (
                <li><a href={href} class={i === 0 ? 'is-active' : ''}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}

        <div class="footer-news">
          <h4 class="footer-news-title">Join our newsletter</h4>
          <p>Get seasonal maintenance reminders and service updates. No spam.</p>
          <form class="news-form" novalidate>
            <input type="email" name="newsletter_email" aria-label="Your email address" placeholder="Your email address" required />
            <button type="submit">Subscribe</button>
            <p class="news-confirmation" role="status" hidden>Thanks — you're on the list.</p>
          </form>
        </div>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-legal">
        <span>Since {buildYear} · Canyon Country, CA 91387</span>
        <span>© {buildYear} One-Stop Heating &amp; Cooling Inc. · CSLB #1159265 · Concept project</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #12253a; background: #f7f9fb; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; }
  header { display: grid; grid-template-columns: 220px 1fr auto; align-items: center; gap: 2rem; max-width: 1440px; margin: auto; padding: .65rem 2rem; min-height: 94px; }
  .brand { display: inline-flex; align-items: center; text-decoration: none; }
  .brand img { display: block; width: 176px; height: 74px; object-fit: contain; object-position: left center; }
  nav { display: flex; align-items: center; justify-content: center; gap: .35rem; }
  nav a { padding: .65rem .9rem; border-radius: 999px; text-decoration: none; font-weight: 750; font-size: .9rem; }
  nav a.active { color: white; background: #2d82b5; }
  .header-actions { display: flex; align-items: center; gap: 1.2rem; }
  .header-phone { text-decoration: none; font-weight: 850; white-space: nowrap; }
  .button.dark { background: #10283f; }
  .hero, .section, .cta, .form-section { padding: clamp(5rem, 8vw, 8rem) max(2rem, calc((100vw - 1420px) / 2)); }
  .hero { min-height: 760px; display: grid; grid-template-columns: minmax(0, .9fr) minmax(520px, 1.1fr); align-items: center; gap: clamp(3rem, 5vw, 6rem); background: radial-gradient(circle at 90% 55%, rgba(77, 186, 174, .1), transparent 36%), #fbfcfe; overflow: hidden; }
  .hero-copy { position: relative; z-index: 1; }
  .hero-visual { position: relative; min-width: 0; }
  .hero-photo { display: block; width: 100%; min-height: 610px; max-height: 650px; object-fit: cover; object-position: 58% center; border-radius: 34px; box-shadow: 14px 14px 0 rgba(16, 40, 63, .13); }
  .estimate-card { position: absolute; left: -34px; bottom: 24px; width: min(390px, 88%); padding: 1.6rem; border: 1px solid rgba(16, 40, 63, .09); border-radius: 24px; background: white; box-shadow: 0 24px 60px rgba(16, 40, 63, .2); }
  .estimate-heading { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding-bottom: 1rem; border-bottom: 1px solid #dfe6eb; }
  .estimate-heading h2 { margin: .15rem 0 0; font-size: 1.6rem; letter-spacing: -.03em; }
  .estimate-heading img { width: 40px; height: 50px; object-fit: contain; }
  .estimate-kicker { color: #2d82b5; font-size: .7rem; font-weight: 900; text-transform: uppercase; letter-spacing: .12em; }
  .estimate-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: .25rem; margin: 1rem 0; padding: .25rem; border-radius: 10px; background: #eef2f6; font-size: .8rem; font-weight: 850; text-align: center; }
  .estimate-tabs span { padding: .65rem .35rem; border-radius: 8px; }
  .estimate-tabs .selected { color: #2d82b5; background: white; box-shadow: 0 1px 3px rgba(16, 40, 63, .1); }
  .estimate-field { display: flex; flex-direction: column; gap: .35rem; padding: .85rem 1rem; border: 1px solid #d8e0e7; border-radius: 9px; }
  .estimate-field span { color: #6d7c8c; font-size: .7rem; text-transform: uppercase; }
  .estimate-field strong { font-size: .9rem; }
  .estimate-card > p { margin: 1rem 0; color: #637486; font-size: .85rem; line-height: 1.5; }
  .estimate-button { display: flex; justify-content: center; width: 100%; }
  .eyebrow { color: #d94b32; font-weight: 900; text-transform: uppercase; letter-spacing: .14em; font-size: .75rem; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 720px; font-size: clamp(3.4rem, 5.2vw, 5.5rem); line-height: 1; letter-spacing: -.06em; margin-bottom: 1.7rem; }
  h1 span { color: #2d82b5; text-decoration: underline; text-decoration-color: #9fdcd3; text-decoration-thickness: .12em; text-underline-offset: -.02em; }
  h2 { font-size: clamp(2.25rem, 4vw, 4rem); line-height: 1; letter-spacing: -.045em; }
  .lead, .intro { max-width: 720px; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.65; color: #506275; }
  .actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2rem; flex-wrap: wrap; }
  .button { display: inline-flex; padding: 1rem 1.4rem; color: white; background: #d94b32; border-radius: .35rem; text-decoration: none; font-weight: 850; }
  .button.small { padding: .7rem 1rem; }
  .text-link { font-weight: 850; text-underline-offset: .3rem; }
  .secondary-button { display: inline-flex; padding: .95rem 1.3rem; border: 1px solid #d8e0e7; border-radius: .5rem; background: white; text-decoration: none; font-weight: 850; box-shadow: 0 6px 16px rgba(16, 40, 63, .07); }
  .trust-pills { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 2rem; }
  .trust-pills span { padding: .65rem .9rem; border: 1px solid #e2e8ed; border-radius: 999px; background: white; box-shadow: 0 5px 13px rgba(16, 40, 63, .06); font-size: .78rem; font-weight: 800; }
  .services-accordion { display: flex; gap: 12px; margin-top: 4rem; }
  .svc-panel { flex: 1 1 0; min-width: 0; position: relative; height: 420px; padding: 2rem; overflow: hidden; border-radius: 16px; background: #10283f; color: #fff; cursor: pointer; display: flex; flex-direction: column; justify-content: flex-end; transition: flex-grow .6s cubic-bezier(.25, .46, .45, .94); }
  .svc-panel:focus-visible { outline: 3px solid #2d82b5; outline-offset: 3px; }
  .svc-photo { position: absolute; inset: 0; background-size: cover; background-position: center; transform: scale(1.01); transition: transform .7s cubic-bezier(.25, .46, .45, .94); }
  .svc-veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(9, 20, 34, .12) 0%, rgba(9, 20, 34, .5) 52%, rgba(9, 20, 34, .88) 100%); transition: background .45s ease; }
  .svc-index, .svc-arrow, .svc-body { position: relative; z-index: 1; }
  .svc-index { position: absolute; top: 1.6rem; left: 2rem; font-size: .8rem; font-weight: 900; letter-spacing: .1em; color: #fff; opacity: .85; }
  .svc-arrow { position: absolute; top: 1.3rem; right: 1.3rem; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 999px; background: #d94b32; color: #fff; transform: scale(0); transition: transform .4s cubic-bezier(.34, 1.56, .64, 1); }
  .svc-arrow svg { width: 18px; height: 18px; }
  .svc-body h3 { margin: 0; font-size: 1.35rem; letter-spacing: -.02em; text-shadow: 0 1px 12px rgba(9, 20, 34, .5); }
  .svc-body p { margin: 0; max-width: 42ch; max-height: 0; overflow: hidden; color: #dde5ec; line-height: 1.6; font-size: .98rem; opacity: 0; transform: translateY(10px); transition: opacity .4s ease .05s, transform .4s ease .05s, max-height .5s ease, margin-top .5s ease; }
  .svc-panel:first-child, .svc-panel:hover, .svc-panel:focus-within { flex-grow: 3; }
  .svc-panel:first-child .svc-photo, .svc-panel:hover .svc-photo, .svc-panel:focus-within .svc-photo { transform: scale(1.12); }
  .svc-panel:first-child .svc-body p, .svc-panel:hover .svc-body p, .svc-panel:focus-within .svc-body p { opacity: 1; transform: none; max-height: 12rem; margin-top: .9rem; }
  .svc-panel:first-child .svc-arrow, .svc-panel:hover .svc-arrow, .svc-panel:focus-within .svc-arrow { transform: scale(1); }
  .services-accordion:has(.svc-panel:not(:first-child):hover) .svc-panel:first-child,
  .services-accordion:has(.svc-panel:not(:first-child):focus-within) .svc-panel:first-child { flex-grow: 1; }
  .services-accordion:has(.svc-panel:not(:first-child):hover) .svc-panel:first-child .svc-photo,
  .services-accordion:has(.svc-panel:not(:first-child):focus-within) .svc-panel:first-child .svc-photo { transform: scale(1.01); }
  .services-accordion:has(.svc-panel:not(:first-child):hover) .svc-panel:first-child .svc-body p,
  .services-accordion:has(.svc-panel:not(:first-child):focus-within) .svc-panel:first-child .svc-body p { opacity: 0; transform: translateY(10px); max-height: 0; margin-top: 0; }
  .services-accordion:has(.svc-panel:not(:first-child):hover) .svc-panel:first-child .svc-arrow,
  .services-accordion:has(.svc-panel:not(:first-child):focus-within) .svc-panel:first-child .svc-arrow { transform: scale(0); }
  .why-us { background: #fff; border-top: 1px solid #e4eaef; }
  .why-us-lead { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(2.5rem, 5vw, 5.5rem); align-items: center; }

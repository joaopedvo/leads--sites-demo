<script>
  const form = document.querySelector('.request-form');
  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      // In the WordPress/Elementor build, submission is handled by Elementor Forms:
      // it stores the entry, emails sales@onestopscvhvac.com, and shows this message.
      form.classList.add('sent');
      const confirmation = form.querySelector('.form-confirmation');
      if (confirmation) {
        confirmation.hidden = false;
        confirmation.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  }

  const newsletter = document.querySelector('.news-form');
  if (newsletter) {
    newsletter.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!newsletter.checkValidity()) {
        newsletter.reportValidity();
        return;
      }
      const note = newsletter.querySelector('.news-confirmation');
      if (note) note.hidden = false;
      newsletter.querySelector('input').value = '';
    });
  }
</script>

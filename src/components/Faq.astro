---
import { faq } from "../data/conteudo";

// FAQPage ajuda a aparecer com as perguntas expandidas no Google.
const schemaFaq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.pergunta,
    acceptedAnswer: { "@type": "Answer", text: item.resposta },
  })),
};
---

<section class="section section--tint" id="faq">
  <div class="container faq__inner">
    <div class="section__head" data-reveal>
      <span class="eyebrow"><span class="eyebrow__dot"></span>Dúvidas</span>
      <h2 class="h2">O que perguntam antes de fechar</h2>
    </div>

    <div class="faq__lista">
      {
        faq.map((item) => (
          <details class="faq__item" data-reveal>
            <summary>
              <span>{item.pergunta}</span>
              <span class="faq__sinal" aria-hidden="true" />
            </summary>
            <p class="faq__resposta">{item.resposta}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />

<style>
  .faq__inner {
    max-width: 820px;
  }

  .faq__lista {
    display: grid;
    gap: 0.7rem;
  }

  .faq__item {
    background: var(--color-paper-000);
    border: 1px solid var(--color-paper-100);
    border-radius: var(--radius-sm);
    padding: 0 var(--space-3);
    transition: border-color 0.25s var(--ease-premium);
  }

  .faq__item[open] {
    border-color: var(--color-brand-300);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block: var(--space-2);
    font-weight: 700;
    font-size: 1.02rem;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__sinal {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .faq__sinal::before,
  .faq__sinal::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto 0;
    height: 2px;
    background: var(--color-brand-600);
    border-radius: 2px;
    transition: transform 0.25s var(--ease-premium);
  }

  .faq__sinal::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__sinal::after {
    transform: rotate(0deg);
  }

  .faq__resposta {
    padding-bottom: var(--space-2);
    color: var(--color-text-onLight-muted);
    line-height: 1.65;
    max-width: 68ch;
  }
</style>

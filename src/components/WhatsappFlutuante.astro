---
import { linkWhatsapp } from "../data/conteudo";
import IconeWhatsapp from "./IconeWhatsapp.astro";
---

<a
  class="flutuante"
  href={linkWhatsapp()}
  target="_blank"
  rel="noopener"
  aria-label="Falar no WhatsApp"
>
  <IconeWhatsapp size={26} />
  <span class="flutuante__rotulo">Falar no WhatsApp</span>
</a>

<script>
  /*
   * O botão é fixo no canto e cobria os botões do CTA final. Some enquanto a
   * seção de contato está na tela — lá os dois números já estão visíveis.
   */
  const flutuante = document.querySelector(".flutuante");
  const contato = document.querySelector("#contato");

  if (flutuante && contato) {
    const io = new IntersectionObserver(
      ([entrada]) => flutuante.classList.toggle("is-oculto", entrada.isIntersecting),
      { threshold: 0.25 }
    );
    io.observe(contato);
  }
</script>

<style>
  .flutuante {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius-pill);
    background: var(--color-whatsapp);
    color: #06331a;
    font-weight: 800;
    box-shadow: 0 12px 30px -10px rgba(37, 211, 102, 0.7);
    transition: transform 0.25s var(--ease-premium), box-shadow 0.25s var(--ease-premium),
      opacity 0.25s var(--ease-premium);
  }

  .flutuante:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 40px -12px rgba(37, 211, 102, 0.8);
  }

  .flutuante.is-oculto {
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
  }

  /* No celular vira só o ícone, para não cobrir o conteúdo. */
  .flutuante__rotulo {
    display: none;
  }

  @media (min-width: 640px) {
    .flutuante {
      right: 1.5rem;
      bottom: 1.5rem;
    }

    .flutuante__rotulo {
      display: inline;
    }
  }
</style>

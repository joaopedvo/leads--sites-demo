---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Ticker from "../components/Ticker.astro";
import Problema from "../components/Problema.astro";
import Servicos from "../components/Servicos.astro";
import Diferenciais from "../components/Diferenciais.astro";
import Processo from "../components/Processo.astro";
import Cobertura from "../components/Cobertura.astro";
import Depoimentos from "../components/Depoimentos.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import Footer from "../components/Footer.astro";
import WhatsappFlutuante from "../components/WhatsappFlutuante.astro";
import { seo, depoimentos, faq } from "../data/conteudo";

/**
 * Depoimentos e FAQ ficam desligados enquanto as listas em conteudo.ts estão
 * vazias: é conteúdo que afirma coisas sobre a empresa e só entra com a
 * palavra do cliente. Preencher a lista liga a seção sozinha.
 */
---

<Layout title={seo.titulo} description={seo.descricao}>
  <Header />
  <main id="conteudo">
    <Hero />
    <Ticker />
    <Problema />
    <Servicos />
    <Diferenciais />
    <Processo />
    <Cobertura />
    {depoimentos.length > 0 && <Depoimentos />}
    {faq.length > 0 && <Faq />}
    <CtaBand />
  </main>
  <Footer />
  <WhatsappFlutuante />
</Layout>
